{
  "info": {
    "name": "KANTINKU API v1 — Tugas Pertemuan 9",
    "description": "26 endpoint aktif backend Laravel + Sanctum. Jalankan Register/Login dulu supaya variabel {{token}} terisi otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth (publik + token)",
      "item": [
        {
          "name": "Register (201 + token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 + access_token. Email duplikat -> 422 dengan pesan 'Email sudah digunakan'.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Riska Dinar\",\n  \"email\": \"riska.baru@kantin.test\",\n  \"password\": \"password123\",\n  \"phone\": \"081234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ada access_token', () => pm.expect(pm.response.json().data.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().data.access_token);",
                  "console.log('token tersimpan otomatis');"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login (200 + token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Password salah -> 401 'Email atau password salah'.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"riska@kantin.test\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ada access_token', () => pm.expect(pm.response.json().data.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().data.access_token);",
                  "console.log('token tersimpan otomatis');"
                ]
              }
            }
          ],
          "response": []
        },
